# 環境変数のテンプレート（このファイルはリポジトリに入れてよい。値は書かない）
#
# 使い方:
#   cp .env.example .env.local
#   .env.local に実際の値を書く（.env.local はリポジトリに入れない・2-4-11）
#
# 4つすべて必須。欠けたまま起動すると lib/env.ts の assertEnv が起動時に止める（3-3-11）。
# 何をどこへ送るかの一覧は docs/notes/external-services.md にある。

# Anthropic API キー（回答の生成）。Anthropic Console で作成（2-4-10）。
ANTHROPIC_API_KEY=

# OpenAI API キー（文書と質問の埋め込み）。OpenAI Platform で作成（3-1-0 2-3）。
OPENAI_API_KEY=

# Supabase プロジェクトの URL と service_role キー（ベクトル検索・pgvector）。
# Supabase のダッシュボード → プロジェクトの設定 → API から取得する。
# service_role キーはサーバー側専用。ブラウザに出してはいけない。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# いずれの変数にも NEXT_PUBLIC_ を付けてはいけない（付けるとブラウザに配られる・2-4-11）。
